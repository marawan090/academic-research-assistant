# OrcaRouter API Configuration (Required for DeepSeek LLM synthesis)
ORCAROUTER_API_KEY=your_orcarouter_api_key_here
ORCAROUTER_BASE_URL=https://www.orcarouter.ai/v1
MODEL_NAME=deepseek/deepseek-v4-flash-free

# Semantic Scholar API Key (Optional: enables higher rate limits via x-api-key header; falls back to public access if blank)
SEMANTIC_SCHOLAR_API_KEY=

# Server Configuration
HOST=127.0.0.1
PORT=8000

