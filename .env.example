# Copy to .env and fill in your own values. Never commit real secrets.

# Key for the model router (OpenAI-compatible).
ORCAROUTER_API_KEY=
# Router base URL (override only if your provider differs).
ORCAROUTER_BASE_URL=https://www.orcarouter.ai/v1
# Model identifier, configurable.
MODEL_NAME=deepseek/deepseek-v4-flash-free
# Fallback model when the primary fails; blank disables fallback.
SECONDARY_MODEL=deepseek/deepseek-chat
# Raises Semantic Scholar rate limits; blank falls back to public access.
SEMANTIC_SCHOLAR_API_KEY=

# Enables admin routes; admin login is disabled when unset.
ADMIN_PASSWORD=
# Optional administrative master code (single value).
MASTER_CODE=
# Optional administrative master keys, comma-separated.
MASTER_ADMIN_KEYS=
# Optional seed list for cohort access codes, comma-separated.
RESEARCHER_CODES=
# Optional seed list for invite/onboarding codes, comma-separated.
INVITE_CODES=
# Expiry date for researcher codes (YYYY-MM-DD); blank means no expiry.
RESEARCHER_CODE_EXPIRY=
# Contact email for the OpenAlex polite pool; blank omits it.
OPENALEX_MAILTO=
# Comma-separated CORS allow-list; blank uses the built-in default list.
ALLOWED_ORIGINS=
# Test-only bypass key; honored only when ENVIRONMENT=test.
SWMP_TEST_KEY=

# Server bind address.
HOST=127.0.0.1
# Server bind port.
PORT=8000
# Set to test only in automated tests.
ENVIRONMENT=

# Supabase project URL for auth and persistence.
SUPABASE_URL=
# Supabase publishable key (also accepted under SUPABASE_ANON_KEY).
SUPABASE_KEY=
# Alternate name for the Supabase publishable key.
SUPABASE_ANON_KEY=
